   classDiagram
    class Owner {
        -owner_id: str
        -name: str
        -email: str
        -phone: str
        -pets: List~Pet~
        +add_pet(pet: Pet) None
        +remove_pet(pet_id: str) None
        +get_pets() List~Pet~
        +update_contact_info(email: str, phone: str) None
    }

    class Pet {
        -pet_id: str
        -name: str
        -species: str
        -breed: str
        -age: int
        -weight: float
        -owner_id: str
        -tasks: List~Task~
        -schedule: Schedule
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +get_profile() dict
        +update_profile(**kwargs) None
    }

    class Task {
        -task_id: str
        -pet_id: str
        -title: str
        -description: str
        -category: str
        -due_date: datetime
        -recurrence: str
        -is_completed: bool
        +mark_complete() None
        +mark_incomplete() None
        +is_overdue() bool
        +reschedule(new_date: datetime) None
    }

    class Schedule {
        -schedule_id: str
        -pet_id: str
        -tasks: List~Task~
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +get_daily_tasks(date: datetime) List~Task~
        +get_upcoming_tasks(days: int) List~Task~
        +get_overdue_tasks() List~Task~
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Pet "1" --> "1" Schedule : has
    Schedule "1" --> "0..*" Task : organizes
